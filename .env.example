# Wzór ustawień. Skopiuj do pliku .env i uzupełnij.
# Nie wpisuj tutaj prawdziwych haseł ani kluczy: ten plik trafia do repozytorium.

# Czas retencji danych w sekundach (od 5 do 604800, czyli 7 dni)
RETENTION_SECONDS=604800

# Wariant modeli: small (środowisko deweloperskie) lub large (serwer docelowy)
MODEL_VARIANT=small

# Urządzenie obliczeniowe: cpu lub cuda
COMPUTE_DEVICE=cpu

# Połączenie z bazą danych
DATABASE_URL=postgresql://user:password@db:5432/anonimizacja

# Klucz główny do szyfrowania AES-256 (uzupełnić lokalnie, nigdy nie commitować)
ENCRYPTION_KEY=
